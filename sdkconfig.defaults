# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=y

# ps5 bluetooth: give BTC more headroom and help with HCI logging stack pressure
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_LOG_HCI_TRACE_LEVEL_ERROR=y

# Increase default frequency to 240 MHz so performance is actually good
# CHANGING THIS MAKES DRIVING REALLY BAD
# This probably won't be necessary later when we actually optimize the codebase
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
